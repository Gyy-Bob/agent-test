# ===== LLM 配置（OpenAI 兼容协议，可自由切换厂商） =====
# DeepSeek 示例:  base_url=https://api.deepseek.com/v1  model=deepseek-chat
# 通义千问示例:  base_url=https://dashscope.aliyuncs.com/compatible-mode/v1  model=qwen-plus
# OpenAI 示例:   base_url=https://api.openai.com/v1  model=gpt-4o-mini
LLM_API_KEY=sk-xxxxxx
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# ===== 数据库 =====
# 本地开发用 SQLite；上云时换成 PostgreSQL，例如:
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/agent_db
DATABASE_URL=sqlite:///./data/app.db

# ===== 文件存储 =====
# 本地开发存磁盘；上云时换成 cos/oss 并改造 storage 服务
STORAGE_BACKEND=local

# ===== 服务 =====
HOST=0.0.0.0
PORT=8000
MAX_UPLOAD_MB=50
